# RoomService Configuration (Used by all games)
ROOMSERVICE_HOST=your-production-host:50052
ROOMSERVICE_API_KEY=your-production-api-key-here

# Game Ports (Railway will handle port mapping)
# Pixel Battle
PORT_PIXEL_BATTLE=3001
# Gartic Phone
PORT_GARTIC_PHONE=3002
# Tic-Tac-Toe
PORT_TIC_TAC_TOE=3000

# Environment
NODE_ENV=production